# ---------------- LLM provider chain ----------------
# Primary provider. Models of this provider are tried first (GEMINI_MODEL, then
# GEMINI_FALLBACK_MODELS in order). If every one fails, the other provider's models
# are tried (cross-provider fallback) when its API key is set.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Optional - only if LLM_PROVIDER=groq (also used as the cross-provider fallback when set)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Retry / timeout policy for the fallback chain
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES_PER_MODEL=1
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_MAX_S=8.0

# ---------------- Retrieval (later phases) ----------------
PINECONE_API_KEY=
PINECONE_DISEASE_INDEX_NAME=tea-disease
PINECONE_HELP_INDEX_NAME=company-help
COHERE_API_KEY=

# ---------------- Observability ----------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tea-support-assistant
PANDASAI_API_KEY=

# ---------------- RAG (on-premises ChromaDB) ----------------
CHROMA_PATH=data/chroma
RAG_COLLECTION=lankalaw_kb
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_STEPS=6
RAG_REFLECT=true

# ---------------- Knowledge graph (on-premises Kùzu, embedded) ----------------
GRAPH_ENABLED=true
GRAPH_PATH=data/graph/lankalaw.kuzu
GRAPH_EXPAND_K=3
INGEST_GRAPH_EXTRACT=true

# ---------------- Web server ----------------
APP_HOST=127.0.0.1
APP_PORT=8080
APP_RELOAD=true

# ---------------- Ingestion ----------------
INGEST_CHUNK_SIZE=1200
INGEST_CHUNK_OVERLAP=150
INGEST_MAX_UPLOAD_MB=10
